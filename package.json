{
  "name": "qwen-math-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run check && vite build",
    "start": "tsx server/src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx server/src/migrate.ts",
    "test:mongodb": "MONGODB_INTEGRATION=1 tsx --test tests/mongodb.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "katex": "^0.16.21",
    "mongodb": "^6.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.51.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
